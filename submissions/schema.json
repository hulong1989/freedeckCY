{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "freedeckCY game submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "platform",
    "share_url",
    "openpath"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "english_name": {
      "type": "string",
      "maxLength": 200
    },
    "platform": {
      "type": "string",
      "enum": [
        "pc",
        "gba",
        "psp",
        "nds",
        "ps1",
        "fc",
        "md",
        "3ds",
        "ps2",
        "ps3",
        "switch"
      ]
    },
    "share_url": {
      "type": "string",
      "pattern": "^https://(cloud\\.189\\.cn|pan\\.baidu\\.com|yun\\.baidu\\.com)/"
    },
    "access_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{0,8}$"
    },
    "share_user_version": {
      "type": "string",
      "maxLength": 200
    },
    "executable_name": {
      "type": "string",
      "maxLength": 260
    },
    "openpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "categories": {
      "type": "string",
      "maxLength": 200
    },
    "category_parent": {
      "type": "string",
      "maxLength": 10
    },
    "filesize_z": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]*$"
    },
    "list_filesize": {
      "type": "string",
      "maxLength": 40
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
